{
  "name": "rogue-hero-4",
  "version": "0.2.0",
  "type": "module",
  "description": "Rogue Hero 4 — an intense neon-arcane 3D roguelike (Three.js + CC0 assets)",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron electron/main.cjs",
    "serve": "vite preview --port 8000 --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8000",
    "assets": "node scripts/assets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "tour": "node scripts/tour.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "perf": "node scripts/perf.mjs",
    "audit": "node scripts/audit.mjs",
    "doctor": "node scripts/doctor.mjs",
    "flow": "node scripts/flow.mjs",
    "vision": "node scripts/vision.mjs",
    "motion": "node scripts/motion.mjs",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "electron": "^31.7.7",
    "puppeteer-core": "^23.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
